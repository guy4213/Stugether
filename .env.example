# ─────────────────────────────────────────────────────────────
# Stugether — environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# Variables without NEXT_PUBLIC_ are server-only.
# ─────────────────────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (server-only — account owned by the client)
GEMINI_API_KEY=
GEMINI_MODEL=

# AI behaviour
AI_TRIGGER_MODE=              # default: mention
AI_CONTEXT_MESSAGES=          # default: 30
AI_MAX_INPUT_TOKENS=          # default: 8000
AI_MAX_OUTPUT_TOKENS=
AI_RATE_LIMIT_USER_PER_HOUR=
AI_RATE_LIMIT_ROOM_PER_HOUR=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
