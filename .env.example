# ─────────────────────────────────────────────────────────────
# Stugether — environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# Variables without NEXT_PUBLIC_ are server-only.
# ─────────────────────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # publishable key (sb_publishable_…)
SUPABASE_SERVICE_ROLE_KEY=      # secret key (sb_secret_…) — server-only

# Google sign-in — read by the local Supabase CLI, not by Next.js: put them in
# supabase/.env (gitignored) and set enabled = true under
# [auth.external.google] in supabase/config.toml. In production they live in
# Supabase Dashboard → Authentication → Providers → Google, not here.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Gemini (server-only — account owned by the client)
GEMINI_API_KEY=
GEMINI_MODEL=                 # default: gemini-2.5-flash

# AI behaviour
AI_TRIGGER_MODE=              # default: mention (only 'mention' is implemented for MVP)
AI_CONTEXT_MESSAGES=          # default: 30
AI_MAX_INPUT_TOKENS=          # default: 8000
AI_MAX_OUTPUT_TOKENS=         # default: 1024
AI_RATE_LIMIT_USER_PER_HOUR=  # default: 30
AI_RATE_LIMIT_ROOM_PER_HOUR=  # default: 60
AI_PRICE_INPUT_PER_MTOK_USD=  # default: 0.30 (admin "estimated cost" only)
AI_PRICE_OUTPUT_PER_MTOK_USD= # default: 2.50

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Email over SMTP (server-only) — room invitation emails. Unset = no emails.
SMTP_HOST=
SMTP_PORT=                    # default: 587 (465 = implicit TLS)
SMTP_USER=
SMTP_PASS=
MAIL_FROM=                    # e.g. "StuGether <no-reply@your-domain>"; default: SMTP_USER
SITE_URL=                     # e.g. https://stugether.example — base of links in emails (default: request host)
